{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "2.5.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "Ronny Elflein",
  "homepage_url": "https://github.com/11lein/ai-mail-cleaner",
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-mail-cleaner@11lein.de",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["personalCommunications"]
      }
    }
  },
  "permissions": [
    "accountsRead",
    "addressBooks",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "compose",
    "storage",
    "https://openrouter.ai/*"
  ],
  "optional_permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "__MSG_actionTitle__",
    "default_label": "__MSG_actionLabel__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
